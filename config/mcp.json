{
  "mcpServers": {
    "gmail": {
      "command": "python",
      "args": [
        "-m",
        "servers.gmail_server"
      ],
      "env": {
        "PYTHONPATH": "",
        "FASTMCP_LOG_LEVEL": "DEBUG",
        "DEBUG_MCP_ENV": "1"
      },
      "disabled": false,
      "autoApprove": [
        "list_recent_gmail_messages"
      ],
      "disabledTools": []
    },
    "slack": {
      "command": "python",
      "args": [
        "-m",
